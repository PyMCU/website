{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Compiler documentation worker. Served publicly through the docs hub
  // (docs.pymcu.org/pymcu/* -> this worker, prefix stripped by the hub);
  // the site is built with base '/pymcu' so every link round-trips the hub.
  "name": "pymcu-docs",
  "compatibility_date": "2025-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
