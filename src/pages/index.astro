---
// Keep this page static in hybrid mode
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import FirmwareSizes from '~/components/widgets/FirmwareSizes.astro';
import Playground from '~/components/widgets/Playground.astro';
import Button from '~/components/ui/Button.astro';

import { DOCS_URL, PLAYGROUND_URL } from '~/navigation';
import { findPostsBySlugs } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'PyMCU: Python Compiler for Microcontrollers (Arduino, AVR, RP2040, PIC)',
  description:
    'PyMCU compiles Python ahead of time to native microcontroller assembly. No interpreter, no heap: a blink is 40 bytes of code on an Arduino Uno. AVR, RP2040, PIC, RISC-V.',
  ignoreTitleTemplate: true,
};

// "How it works" below links to the OLED post. fetchPosts() (which this goes
// through) already filters out drafts, so oledPost is undefined while the
// post is draft: true, and the button is skipped rather than pointing at a
// route that does not exist yet on the deployed site.
const [oledPost] = await findPostsBySlugs(['the-oled-that-froze']);
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Public beta, out now on PyPI"
    actions={[
      {
        variant: 'primary',
        text: 'Try it in your browser',
        href: PLAYGROUND_URL,
        target: '_blank',
        icon: 'tabler:player-play',
      },
      {
        variant: 'secondary',
        text: 'Browse Docs',
        href: DOCS_URL,
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="text dark:text-accent">Py</span><span class="text-accent dark:text-white">MCU</span><span
        class="sr-only">, the Python compiler for microcontrollers</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      The same <span class="font-semibold">MicroPython</span> and <span class="font-semibold">CircuitPython</span> source
      you already write, <span class="font-semibold">compiled ahead of time to bare-metal machine code</span> for the boards
      too small to hold an interpreter. No interpreter, no heap, no garbage collection: deterministic by design, and small
      enough for a $2 Arduino.
      <span class="font-semibold">AVR</span>, <span class="font-semibold">RP2040 / RP2350</span>,
      <span class="font-semibold">PIC</span> and <span class="font-semibold">RISC-V</span>.
    </Fragment>

    <Fragment slot="image">
      <div class="relative flex justify-center m-auto max-w-5xl">
        <img src="/images/pymcu-logo.png" width="512" height="512" alt="PyMCU Logo" loading="eager" decoding="async" />
      </div>
    </Fragment>
  </Hero>

  <!-- From the gallery: Game of Life on an SSD1306, rendered from the actual I2C
       bytes the firmware sends in the emulator. -->

  <Content id="game-of-life" tagline="From the gallery" title="Conway's Game of Life on an OLED">
    <Fragment slot="content">
      <p class="mb-4 text-lg dark:text-slate-400">
        Conway's Game of Life on a 128x64 SSD1306 OLED with Adafruit's unmodified CircuitPython drivers, 13,126 bytes
        (about 13 KB) on an Arduino Uno.
      </p>
      <p class="mb-8 text-sm text-muted dark:text-slate-500">
        Rendered from the I2C bytes the firmware sends in the emulator.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button
          variant="primary"
          text="Read the example"
          href="https://docs.pymcu.org/examples/game-of-life/"
          target="_blank"
        />
        {oledPost && <Button variant="secondary" text="How it works" href={getPermalink(oledPost.slug, 'post')} />}
      </div>
    </Fragment>
    <Fragment slot="image">
      <div class="mx-auto" style="position: relative; width: 450px; max-width: 100%; aspect-ratio: 27.7 / 22.6;">
        <img
          src="/images/wokwi-ssd1306-board.svg"
          alt="SSD1306 OLED module"
          style="position: absolute; inset: 0; width: 100%; height: 100%; display: block;"
        />
        <canvas
          id="gol-home-screen"
          width="128"
          height="64"
          data-gol-frames="/data/game-of-life-frames.json"
          style="position: absolute; left: 5.271%; top: 23.319%; width: 89.531%; height: 54.867%; image-rendering: pixelated;"
        ></canvas>
      </div>
      <p class="mt-2 text-center text-xs text-muted dark:text-slate-500">
        OLED board artwork by
        <a href="https://github.com/wokwi/wokwi-boards" target="_blank" class="underline">Wokwi</a>
        (wokwi-boards, Uri Shaked). The real, unmodified board art, live in your browser.
      </p>
    </Fragment>
  </Content>

  <script is:inline type="module" src="/scripts/gol-board-animate.js"></script>

  <!-- Firmware size comparison (C / PyMCU / Arduino): first thing under the hero -->

  <FirmwareSizes />

  <!-- Playground: the reader can verify the numbers above without installing anything -->

  <Playground id="playground" />

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Determinism, No OS and High Performance" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="What you will get with PyMCU"
    subtitle="A free, deterministic compiler designed to bring the simplicity of Python to microcontrollers. A new way to write embedded software that is predictable, efficient and accessible."
    items={[
      {
        title: 'Ahead-Of-Time Compilation',
        description:
          'PyMCU is an AOT compiler that turns a statically-typed subset of Python into efficient bare-metal machine code.',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'Zero Runtime Overhead',
        description:
          'Run firmware without a heap, interpreter, or garbage collection. Enjoy the full performance of your MCU.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Four Architectures',
        description:
          'AVR is the mature backend, validated on real silicon. ARM (RP2040 / RP2350), PIC and RISC-V compile and run today as alpha backends: from a $2 ATtiny to a dual-core Pico 2, from the same source.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Deterministic Execution',
        description: 'Predictable timing for your embedded projects, ensuring your code runs exactly when it should.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Ready-to-use HALs',
        description: 'Hardware Abstraction Layers that make GPIO, timers, and peripherals easy to use from day one.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Open Source',
        description: 'PyMCU is community-driven and licensed under MIT, open for feedback and contributions.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="inside-pymcu"
    tagline="Inside PyMCU"
    title="Python Meets Bare Metal!"
    columns={2}
    items={[
      {
        title: 'AOT Compilation',
        description:
          'PyMCU transforms a statically-typed subset of Python directly into bare-metal machine code, ensuring peak performance and reliability.',
      },
      {
        title: 'No Heap, No Interpreter',
        description:
          'Unlike other Python implementations for MCUs, PyMCU has zero runtime overhead. No garbage collection and no dynamic memory.',
      },
      {
        title: 'Deterministic Timing',
        description:
          'Built for applications where timing is critical. Your firmware runs predictably without OS interruptions.',
      },
      {
        title: 'One Language, Many Chips',
        description:
          'The same Python compiles for an 8-bit ATmega and a 32-bit Cortex-M33. Pick the board; the compiler picks the backend.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="steps"
    title="Get your first firmware running with PyMCU."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Install the compiler</span>',
        description:
          'Install it with a single command: <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">pipx install --pip-args="--pre" "pymcu-compiler[avr]"</code>. The <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">[avr]</code> extra brings the whole AVR toolchain with it.',
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">Write your code</span>',
        description:
          'Write firmware in a statically-typed subset of Python. Familiar, clean, and compiled directly to bare-metal machine code. Check the <a href="https://docs.pymcu.org" target="_blank" class="underline">documentation</a> to get started.',
        icon: 'tabler:brand-python',
      },
      {
        title: 'Step 3: <span class="font-medium">Flash & test</span>',
        description:
          'Flash the generated binary to your Arduino Uno and enjoy zero runtime overhead and deterministic timing.',
        icon: 'tabler:usb',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Roadmap Widget ******* -->

  <!-- 
  <RoadmapArchitectures
    id="roadmap"
    tagline="Roadmap"
    title="Architecture Support Timeline"
    subtitle="Our planned microcontroller support roadmap"
    columns={2}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </RoadmapArchitectures>
  -->

  <!-- HighlightedPosts Widget ******* -->

  <!--
  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`Deep dives into how PyMCU's compiler works, release notes, and the real bugs
                        found and fixed on the way to a working firmware.
                `}
  />
  -->

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faqs"
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into what PyMCU is, where it’s going, and how it can reshape embedded development with Python."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What is PyMCU?',
        description:
          'PyMCU is an Ahead-Of-Time (AOT) compiler that translates a statically-typed subset of Python into bare-metal machine code. It is designed to be deterministic, lightweight, and efficient, bringing the simplicity of Python into the world of low-level development.',
      },
      {
        title: 'Is PyMCU production-ready?',
        description:
          'Not yet. PyMCU is in public beta (0.1.0b1), available on PyPI. The beta covers the compiler and the AVR backend, with the CircuitPython and MicroPython compatibility layers. It installs and compiles for AVR (the mature backend), the RP2040/RP2350 and PIC (alpha backends); RISC-V (CH32V003) has a working backend in the source tree but is not yet on PyPI. The language and error messages can still change between betas, and the known issues are written down in the release notes. Makers and developers are welcome to try it out and share feedback.',
      },
      {
        title: 'How is PyMCU being built?',
        description:
          'PyMCU is built as an AOT compiler. It parses standard Python using AST, lowers it to a compact Intermediate Representation (IR), and then generates optimized machine code. This approach ensures zero runtime overhead: no interpreter and no heap required.',
      },
      {
        title: 'What license does PyMCU use?',
        description:
          'PyMCU is released under the MIT License: simple, permissive, and open. This ensures anyone can use, adapt, or contribute to the project with full transparency.',
      },
      {
        title: 'Will it support official toolchains?',
        description:
          'Yes, the long-term plan is to align with official toolchains provided by each vendor (such as those for PIC, AVR, and ARM Cortex-M). This will let developers combine PyMCU with trusted ecosystems they already know.',
      },
      {
        title: 'Which architectures are supported?',
        description:
          'Four today, at different levels of maturity. AVR (ATmega328P/Arduino Uno and the wider ATmega/ATtiny family) is the mature backend, continuously validated on real silicon. ARM (RP2040/RP2350, the Raspberry Pi Pico family) and 8-bit PIC compile and run, and are alpha. RISC-V (CH32V003) has a working backend in the compiler source tree, proven in emulation, but is not yet published as an installable package.',
      },
      {
        title: 'How does it differ from MicroPython or CircuitPython?',
        description:
          'They are not rivals: MicroPython and CircuitPython are the languages and APIs PyMCU compiles, and PyMCU’s own compatibility layers replicate their machine/board APIs as libraries. The difference is where the Python runs. MicroPython and CircuitPython bring an interpreter onto the chip, which needs enough flash and RAM to hold it. PyMCU compiles the same kind of source ahead of time into native machine code, so it reaches chips too small for an interpreter (the ATmega328P, ATtiny, PIC, CH32V003) and cases where timing has to be exact, like an interrupt handler or a bit-banged sensor protocol.',
      },
      {
        title: 'Will PyMCU compile into a module an interpreter can load?',
        description:
          "Not yet, and it's a future direction rather than a shipped feature: compiling a Python module ahead of time into a native extension that a MicroPython- or CircuitPython-style interpreter can import, so a timing-critical piece of a driver would run as compiled code inside an interpreter project instead of interpreted line by line. Nothing here is available today.",
      },
      {
        title: 'How can I get involved?',
        description:
          'You can help shape PyMCU by following the project on GitHub, sharing feedback, and contributing code, documentation, or testing. Every contribution helps strengthen and grow the ecosystem.',
      },
    ]}
  />

  {
    /* Datos estructurados. Solo hechos comprobables y visibles en la pagina: nada
      de valoraciones ni de cifras de descarga inventadas, que es justo lo que
      Google penaliza cuando el marcado no corresponde con lo que se ve. */
  }
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'PyMCU',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Compiler',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: '0.1.0b1',
      url: 'https://pymcu.org',
      downloadUrl: 'https://pypi.org/project/pymcu-compiler/',
      codeRepository: 'https://github.com/PyMCU/PyMCU',
      license: 'https://opensource.org/licenses/MIT',
      description:
        'An ahead-of-time compiler that translates a subset of Python into native microcontroller assembly, with no interpreter and no heap. Targets AVR, ARM (RP2040 / RP2350) and 8-bit PIC.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'Iván Montiel Cardona' },
    })}
  />
</Layout>
