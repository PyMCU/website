---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
  description:
    'How to reach the PyMCU project: report a bug, ask a question, or get in touch about using the compiler.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Get in touch"
    subtitle="PyMCU is a one-person open-source project, so the fastest answer is usually a public one: someone else has probably hit the same thing."
  />

  <Features2
    title="Where to write"
    items={[
      {
        title: 'Report a bug',
        description:
          'Open an issue on GitHub. Wrong code generated, a build that fails, a chip that misbehaves: include the Python source and the target board, and the assembly listing from dist/firmware.asm if you have it.',
        icon: 'tabler:bug',
      },
      {
        title: 'Ask a question',
        description:
          'GitHub Discussions is the place for "how do I do X", "is Y supported yet" and design conversations. Questions asked there help the next person who searches for the same thing.',
        icon: 'tabler:messages',
      },
      {
        title: 'Email',
        description: 'contact@pymcu.org — for anything that does not belong in public: hardware, partnerships, press.',
        icon: 'tabler:mail',
      },
      {
        title: 'Before you write',
        description:
          'The Limitations page lists what PyMCU deliberately does not compile, and why. A good share of questions are answered there, and it will tell you quickly whether your use case fits.',
        icon: 'tabler:book',
      },
      {
        title: 'Response time',
        description:
          'One person maintains this, mostly outside working hours. Issues usually get a first reply within a few days. There is no support contract, and this page will not pretend otherwise.',
        icon: 'tabler:clock',
      },
      {
        title: 'Support the project',
        description:
          'PyMCU is free and MIT licensed. If it saves you time, GitHub Sponsors and Ko-fi keep the hardware coming: every backend gets validated on real silicon before it ships.',
        icon: 'tabler:heart',
      },
    ]}
  />
</Layout>
