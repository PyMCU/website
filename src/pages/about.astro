---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Layout from '~/layouts/PageLayout.astro';
import { PLAYGROUND_URL, DOCS_URL } from '~/navigation';

const metadata = {
  title: 'About',
  description:
    'PyMCU compiles a subset of Python ahead of time into native microcontroller assembly — no interpreter, no heap. Why it exists, what it targets, and who builds it.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About"
    image={{
      src: '/images/pymcu-logo.png',
      alt: 'The PyMCU logo: a snake coiled over a microcontroller chip',
    }}
  >
    <Fragment slot="title">
      Python that compiles to <br />
      <span class="text-accent dark:text-white">bare metal</span>
    </Fragment>

    <Fragment slot="subtitle">
      MicroPython and CircuitPython put an interpreter on the chip, and the interpreter needs more RAM than the 8-bit
      parts have. PyMCU takes the other route: it compiles a subset of Python ahead of time, straight to native
      assembly. No interpreter, no heap, no C in between. The Python you read is the firmware you flash.
    </Fragment>
  </Hero>

  <Stats
    title="A blink on an Arduino Uno"
    stats={[
      { title: 'Code', amount: '38 B' },
      { title: 'RAM used', amount: '0 B' },
      { title: 'Architectures', amount: '3' },
      { title: 'License', amount: 'MIT' },
    ]}
  />

  <Features2
    title="What it actually does"
    subtitle="Every claim here is measured on hardware, not estimated."
    items={[
      {
        title: 'Abstractions that cost nothing',
        description:
          'Pin(13, Pin.OUT) becomes a single SBI instruction. The object is gone before the code reaches the board — classes, properties and drivers resolve at compile time, so you pay in bytes you can count.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Three architectures, one language',
        description:
          'AVR for the Arduino Uno and its family, ARM for the Raspberry Pi Pico and Pico 2, and 8-bit PIC. The compiler emits a shared intermediate representation; each backend turns it into assembly for its own silicon.',
        icon: 'tabler:microwave',
      },
      {
        title: 'MicroPython and CircuitPython dialects',
        description:
          'Compatibility layers mean existing code and existing tutorials mostly carry over. You write the API you already know; it just stops needing an interpreter underneath.',
        icon: 'tabler:brand-python',
      },
      {
        title: 'Validated on real silicon',
        description:
          'Emulators catch most things and miss the rest. Every release is flashed to physical boards and verified there, because more than one bug has only ever appeared on the real chip.',
        icon: 'tabler:circuit-changeover',
      },
      {
        title: 'Try it without installing anything',
        description: `The playground runs the whole compiler in your browser and simulates the board: write Python, read the assembly it produced, watch the LED blink. ${PLAYGROUND_URL}`,
        icon: 'tabler:player-play',
      },
      {
        title: 'Alpha, and honest about it',
        description: `Version 0.1.0a5 is on PyPI. The language subset is documented, and so is what it deliberately will not compile — see the docs at ${DOCS_URL}. Expect sharp edges; expect them to be written down.`,
        icon: 'tabler:flask',
      },
    ]}
  />

  <Features2
    title="Who builds it"
    items={[
      {
        title: 'One person',
        description:
          'PyMCU is written and maintained by Iván Montiel Cardona as a personal open-source project, unaffiliated with any employer. It is built in close collaboration with AI tooling — that is how a one-person project sustains a compiler, three backends, emulators and this much testing discipline.',
        icon: 'tabler:user-code',
      },
      {
        title: 'Why it exists',
        description:
          'Because the board that taught millions of people electronics never got to speak Python, and the reason was an implementation detail rather than a law of nature. Compiling instead of interpreting removes it.',
        icon: 'tabler:bulb',
      },
      {
        title: 'How to help',
        description:
          'Try it and report what breaks. A bug found on hardware someone else owns is worth more than any feature request — it is the part a single maintainer cannot cover alone.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  />
</Layout>
