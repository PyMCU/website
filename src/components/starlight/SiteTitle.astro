---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
  {/* Both halves live inside ONE flex item: .site-title sets a flex `gap`, so two
      sibling spans would render as "Py MCU" with a gap between them. */}
  <span class="site-title__word"
    ><span class="site-title__py">Py</span><span class="site-title__mcu">MCU</span></span
  >
</a>

<style>
  /* Mirrors the .site-title rules of Starlight's own SiteTitle, which are scoped to
     that component and therefore lost when it is overridden. */
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    /* 800 + tight tracking is how the hub sets the wordmark. */
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .site-title__word {
    overflow: hidden;
  }

  /* --pymcu-logo-* are the hub's wordmark colors, defined per theme in
     src/styles/custom.css: dark Py #4a9fd4 / MCU #ffffff, light Py #101010 /
     MCU #2a7cb5. */
  .site-title__py {
    color: var(--pymcu-logo-py);
  }

  .site-title__mcu {
    color: var(--pymcu-logo-mcu);
  }
</style>
