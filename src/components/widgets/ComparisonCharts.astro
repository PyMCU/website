---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<section {id} class="py-12 sm:py-16 lg:py-20 mx-auto max-w-5xl px-6">
  <div class="mb-10 text-center">
    <p class="text-base font-semibold uppercase tracking-widest text-accent mb-2">By the numbers</p>
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white">PyMCU vs MicroPython</h2>
    <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto text-sm">
      A blink program — the embedded "Hello, World" — compiled with each tool.
      Numbers sourced from the PyMCU compiler output and MicroPython v1.23 for ATmega.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

    <!-- Flash Usage -->
    <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-sm">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-5">
        Flash usage (blink firmware)
      </h3>

      <!-- PyMCU -->
      <div class="mb-5">
        <div class="flex justify-between items-baseline mb-1">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">PyMCU</span>
          <span class="text-sm font-bold text-accent">124 B</span>
        </div>
        <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-3 overflow-hidden">
          <div
            class="h-3 rounded-full bg-accent transition-all duration-700"
            style="width: 0.05%"
            aria-label="124 bytes out of 262144"
          ></div>
        </div>
      </div>

      <!-- MicroPython -->
      <div>
        <div class="flex justify-between items-baseline mb-1">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">MicroPython</span>
          <span class="text-sm font-bold text-gray-400">~256 KB</span>
        </div>
        <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-3 overflow-hidden">
          <div
            class="h-3 rounded-full bg-gray-400 dark:bg-gray-500 transition-all duration-700"
            style="width: 100%"
            aria-label="~262144 bytes"
          ></div>
        </div>
      </div>

      <p class="mt-4 text-xs text-gray-400 dark:text-gray-500">
        MicroPython embeds a full interpreter (~256 KB) before a single line of your code runs.
        PyMCU compiles only your program — no runtime included.
      </p>
    </div>

    <!-- SRAM Usage -->
    <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-sm">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-5">
        SRAM usage (blink firmware)
      </h3>

      <!-- PyMCU -->
      <div class="mb-5">
        <div class="flex justify-between items-baseline mb-1">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">PyMCU</span>
          <span class="text-sm font-bold text-accent">0 B</span>
        </div>
        <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-3 overflow-hidden">
          <div
            class="h-3 rounded-full bg-accent"
            style="width: 0%"
            aria-label="0 bytes"
          ></div>
        </div>
      </div>

      <!-- MicroPython -->
      <div>
        <div class="flex justify-between items-baseline mb-1">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">MicroPython</span>
          <span class="text-sm font-bold text-gray-400">~16 KB</span>
        </div>
        <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-3 overflow-hidden">
          <div
            class="h-3 rounded-full bg-gray-400 dark:bg-gray-500"
            style="width: 100%"
            aria-label="~16384 bytes"
          ></div>
        </div>
      </div>

      <p class="mt-4 text-xs text-gray-400 dark:text-gray-500">
        PyMCU's blink program allocates no global SRAM — every value lives in registers or the stack.
        MicroPython's runtime heap occupies a significant portion of the ATmega's 2 KB.
      </p>
    </div>

  </div>

  <!-- Summary row -->
  <div class="mt-8 grid grid-cols-3 gap-4 text-center">
    <div class="rounded-xl bg-accent/10 dark:bg-accent/20 p-4">
      <p class="text-2xl font-extrabold text-accent">2000×</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">smaller flash footprint</p>
    </div>
    <div class="rounded-xl bg-accent/10 dark:bg-accent/20 p-4">
      <p class="text-2xl font-extrabold text-accent">0</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">bytes of runtime overhead</p>
    </div>
    <div class="rounded-xl bg-accent/10 dark:bg-accent/20 p-4">
      <p class="text-2xl font-extrabold text-accent">Native</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">16 MHz AVR execution</p>
    </div>
  </div>
</section>
