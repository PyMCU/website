---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<section {id} class="py-12 sm:py-16 lg:py-20 mx-auto max-w-5xl px-6">
  <div class="mb-10 text-center">
    <p class="text-base font-semibold uppercase tracking-widest text-accent mb-2">Python vs Python</p>
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Same syntax. Very different requirements.</h2>
    <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-2xl mx-auto text-sm">
      MicroPython ships a full Python interpreter to the chip — it needs hundreds of KB just to boot.
      PyMCU compiles your Python to native AVR code. No runtime. No interpreter. An Arduino Uno is enough.
    </p>
  </div>

  <!-- Side by side chip requirements -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

    <!-- MicroPython / RP2040 -->
    <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">MicroPython</span>
        <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 px-2 py-0.5 rounded-full">RP2040 · Raspberry Pi Pico</span>
      </div>
      <div class="space-y-4">
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-gray-500">Interpreter firmware</span>
            <span class="font-bold text-gray-500">~640 KB flash</span>
          </div>
          <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-2.5">
            <div class="h-2.5 rounded-full bg-gray-400 dark:bg-gray-500" style="width:31%"></div>
          </div>
          <p class="text-right text-xs text-gray-400 mt-0.5">31% of 2 MB — before your code</p>
        </div>
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-gray-500">Python heap (default)</span>
            <span class="font-bold text-gray-500">~192 KB SRAM</span>
          </div>
          <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-2.5">
            <div class="h-2.5 rounded-full bg-gray-400 dark:bg-gray-500" style="width:72%"></div>
          </div>
          <p class="text-right text-xs text-gray-400 mt-0.5">72% of 264 KB — for the GC heap</p>
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-500">
        The RP2040 is a capable chip, but most of its resources go to running the interpreter —
        not your application.
      </p>
    </div>

    <!-- PyMCU / ATmega328P -->
    <div class="rounded-2xl border border-accent/40 bg-white dark:bg-gray-800 p-6 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">PyMCU</span>
        <span class="text-xs bg-accent/10 text-accent px-2 py-0.5 rounded-full">ATmega328P · Arduino Uno</span>
      </div>
      <div class="space-y-4">
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-gray-500">Runtime overhead</span>
            <span class="font-bold text-accent">0 B flash</span>
          </div>
          <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-2.5">
            <div class="h-2.5 rounded-full bg-accent" style="width:0%"></div>
          </div>
          <p class="text-right text-xs text-gray-400 mt-0.5">no interpreter shipped to chip</p>
        </div>
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-gray-500">Blink firmware (total)</span>
            <span class="font-bold text-accent">124 B flash</span>
          </div>
          <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-2.5">
            <div class="h-2.5 rounded-full bg-accent" style="width:0.4%"></div>
          </div>
          <p class="text-right text-xs text-gray-400 mt-0.5">0.4% of 32 KB — your whole program</p>
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-500">
        The ATmega328P has 32 KB of flash and 2 KB of SRAM — hardware that MicroPython cannot
        even boot on. PyMCU makes it a viable Python target.
      </p>
    </div>
  </div>

  <!-- Stat summary -->
  <div class="grid grid-cols-3 gap-4 text-center mb-8">
    <div class="rounded-xl bg-accent/10 dark:bg-accent/20 p-4">
      <p class="text-2xl font-extrabold text-accent">$2</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Arduino Uno — enough hardware for PyMCU</p>
    </div>
    <div class="rounded-xl bg-accent/10 dark:bg-accent/20 p-4">
      <p class="text-2xl font-extrabold text-accent">0 B</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">runtime overhead on chip</p>
    </div>
    <div class="rounded-xl bg-accent/10 dark:bg-accent/20 p-4">
      <p class="text-2xl font-extrabold text-accent">No GC</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">deterministic timing, always</p>
    </div>
  </div>

  <!-- See it in action callout -->
  <div class="rounded-2xl border border-accent/30 bg-accent/5 dark:bg-accent/10 p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="flex-1">
      <p class="text-sm font-semibold text-gray-900 dark:text-white">See it in action with the DHT11</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
        Same Python syntax. MicroPython runs it on an interpreter — GC pauses included.
        PyMCU compiles it to 40 cycle-accurate AVR instructions. No hidden C, no surprises.
      </p>
    </div>
    <a href="/blog/reading-a-dht11-with-pymcu" class="shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold text-accent border border-accent/40 rounded-lg px-4 py-2 hover:bg-accent hover:text-white transition-colors">
      Read the post →
    </a>
  </div>
</section>
